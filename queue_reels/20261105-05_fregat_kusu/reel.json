  "segments": [
    {
      "text": "Bu kuş günlerce hiç inmeden havada kalabiliyor.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Muhteşem fregat kuşu, fregat kuşlarının en büyüğü.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Kanat açıklığı 2,4 metreye ulaşıyor ama ağırlığı en fazla 1,6 kilo.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Saatte 153 kilometreye varan hızla uçabiliyor.",
      "image": "p4.jpg",
      "cx": 0.5,
      "cy": 0.4,
      "motion": "pan_left"
    },
    {
      "text": "Sıcak hava akımlarıyla 2.500 metre yüksekliğe kadar süzülüyor.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Uçan balıkları avlıyor, bazen de başka kuşları kovalayıp yediklerini kusturuyor.",
      "image": "p6.jpg",
      "cx": 0.5,
      "cy": 0.4,
      "motion": "zoom_in"
    },
    {
      "text": "Erkeğin kırmızı boğaz kesesi, çiftleşme mevsiminde balon gibi şişiyor.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Yumurtadan sonra baba terk ediyor, anne yavruyu neredeyse bir yıl besliyor.",
      "image": "p8.jpg",
      "cx": 0.6,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    }
