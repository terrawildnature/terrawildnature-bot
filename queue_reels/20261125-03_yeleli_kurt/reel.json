 "segments": [
  {
   "text": "Bu hayvan ne tilki ne de kurt.",
   "image": "p1.jpg",
   "cx": 0.4,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Yeleli kurt, Güney Amerika'nın en büyük köpekgili.",
   "image": "p2.jpg",
   "cx": 0.65,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Omuzda yüz on santime kadar yükselerek yabani köpekgillerin en uzun boylusu.",
   "image": "p3.jpg",
   "cx": 0.45,
   "cy": 0.5,
   "motion": "zoom_in"
  },
  {
   "text": "Uzun bacaklarının, yüksek otlaklarda yaşamaya uyum olduğu düşünülüyor.",
   "image": "p4.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Ensesindeki siyah yele dikilebiliyor.",
   "image": "p5.jpg",
   "cx": 0.8,
   "cy": 0.45,
   "motion": "pan_left"
  },
  {
   "text": "Kulakları on sekiz santim uzunluğunda.",
   "image": "p6.jpg",
   "cx": 0.6,
   "cy": 0.55,
   "motion": "pan_left"
  },
  {
   "text": "Hem et hem meyve yiyor ve kurt elması tohumlarının yayılmasına yardım ediyor.",
   "image": "p7.jpg",
   "cx": 0.75,
   "cy": 0.55,
   "motion": "pan_left"
  },
  {
   "text": "En yakın akrabası çalı köpeği; IUCN ise onu yakın tehdit altında listeliyor.",
   "image": "p8.jpg",
   "cx": 0.35,
   "cy": 0.55,
   "motion": "pan_right"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p9.jpg",
   "cx": 0.4,
   "cy": 0.6,
   "motion": "pan_right"
  }
 ],
