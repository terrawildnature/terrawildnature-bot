 "segments": [
  {
   "text": "Bu hayvanın erkekleri bir zamanlar ayrı bir tür sanıldı.",
   "image": "p1.jpg",
   "cx": 0.65,
   "cy": 0.6,
   "motion": "pan_right"
  },
  {
   "text": "Güney Amerika koatisi rakun ailesinden; ağırlığı iki ile yedi kilo arasında.",
   "image": "p2.jpg",
   "cx": 0.3,
   "cy": 0.55,
   "motion": "pan_right"
  },
  {
   "text": "Boyunun yarısı, halkalı kuyruğundan oluşuyor.",
   "image": "p3.jpg",
   "cx": 0.3,
   "cy": 0.4,
   "motion": "pan_right"
  },
  {
   "text": "Dişiler on beş ile otuz hayvanlık sürüler hâlinde yaşıyor.",
   "image": "p4.jpg",
   "cx": 0.4,
   "cy": 0.5,
   "motion": "zoom_in"
  },
  {
   "text": "Erkekler çoğunlukla tek başına dolaşıyor; bu yüzden farklı tür sanıldılar.",
   "image": "p5.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "zoom_out"
  },
  {
   "text": "Uzun burnuyla çatlaklara sokulup böcek ve küçük hayvanlar arıyor, meyve de yiyor.",
   "image": "p6.jpg",
   "cx": 0.45,
   "cy": 0.6,
   "motion": "pan_left"
  },
  {
   "text": "Tehlike anında ağaca tırmanıyor, sonra yere atlayıp dağılıyor.",
   "image": "p7.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "zoom_in"
  },
  {
   "text": "Doğada yedi yıla kadar yaşayabiliyor.",
   "image": "p8.jpg",
   "cx": 0.5,
   "cy": 0.65,
   "motion": "zoom_in"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p9.jpg",
   "cx": 0.35,
   "cy": 0.4,
   "motion": "pan_right"
  }
 ],
