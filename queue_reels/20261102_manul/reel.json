  "segments": [
    {
      "text": "Manulun kürkünde santimetrekare başına dokuz bine kadar tüy var.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Orta Asya'dan Moğolistan'a, Tibet Platosu'na kadar uzanan kayalık dağlarda yaşıyor.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Kar örtüsünün yirmi santimetreyi geçmediği yerleri seviyor.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Yuvarlak kulakları başının yanlarında alçakta durur; böylece kayaların üstünden gözetleyebilir.",
      "image": "p4.jpg",
      "cx": 0.72,
      "cy": 0.72,
      "motion": "pan_left"
    },
    {
      "text": "Gözbebekleri güneşte küçük, yuvarlak bir noktaya daralır.",
      "image": "p5.jpg",
      "cx": 0.3,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Ağırlıklı olarak pika, tavşan ve kemirgenlerle besleniyor.",
      "image": "p6.jpg",
      "cx": 0.35,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Avını yuva çıkışlarında bekler, kemirgenleri patisiyle yuvadan çekip çıkarır.",
      "image": "p7.jpg",
      "cx": 0.2,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Dişi bir seferde iki ile altı yavru doğurur.",
      "image": "p8.jpg",
      "cx": 0.35,
      "cy": 0.4,
      "motion": "pan_left"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p9.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    }
  ],
