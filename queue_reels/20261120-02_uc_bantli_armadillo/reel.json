 "segments": [
  {
   "text": "Dünyada kendini tam bir top hâline getirebilen yalnızca iki armadillo türü var.",
   "image": "p1.jpg",
   "cx": 0.85,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Biri, güney üç bantlı armadillo.",
   "image": "p2.jpg",
   "cx": 0.3,
   "cy": 0.45,
   "motion": "pan_left"
  },
  {
   "text": "Ağırlığı bir ile bir buçuk kilo arasında; en küçük armadilloların başında geliyor.",
   "image": "p3.jpg",
   "cx": 0.85,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Üç esnek bandı sayesinde başı ve kuyruğu birleşiyor.",
   "image": "p4.jpg",
   "cx": 0.3,
   "cy": 0.7,
   "motion": "zoom_in"
  },
  {
   "text": "Böylece karnı, bacakları, gözleri ve kulakları zırhın içinde kalıyor.",
   "image": "p5.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "zoom_out"
  },
  {
   "text": "Zırhı, insan tırnağıyla aynı proteinden, keratinden yapılmış.",
   "image": "p6.jpg",
   "cx": 0.75,
   "cy": 0.8,
   "motion": "zoom_in"
  },
  {
   "text": "Uzun, yapışkan diliyle karınca ve termit yiyor.",
   "image": "p7.jpg",
   "cx": 0.2,
   "cy": 0.5,
   "motion": "zoom_out"
  },
  {
   "text": "Arjantin, Paraguay, Bolivya ve Brezilya'da yaşıyor; ama tarım yüzünden tehdit altında.",
   "image": "p8.jpg",
   "cx": 0.3,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p9.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  }
 ],
