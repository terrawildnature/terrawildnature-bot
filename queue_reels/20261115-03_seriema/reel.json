 "segments": [
  {"text": "Bu kuş avını gagasıyla kapıp defalarca yere çarparak öldürüyor.", "image": "p1.jpg", "cx": 0.5, "cy": 0.35, "motion": "pan_right"},
  {"text": "Adı kızıl bacaklı seriema.", "image": "p5.jpg", "cx": 0.58, "cy": 0.25, "motion": "zoom_in"},
  {"text": "Boyu yaklaşık yetmiş beş ile doksan santimetreyi buluyor.", "image": "p2.jpg", "cx": 0.45, "cy": 0.35, "motion": "pan_left"},
  {"text": "Çok uzun, somon renkli bacakları ve kızıl bir gagası var.", "image": "p3.jpg", "cx": 0.5, "cy": 0.5, "motion": "pan_right"},
  {"text": "Güney Amerika'nın otlaklarında yaşıyor ve insandan hızlı koşabiliyor.", "image": "p4.jpg", "cx": 0.45, "cy": 0.4, "motion": "pan_left"},
  {"text": "Şarkısı kilometrelerce öteden duyulabiliyor.", "image": "p6.jpg", "cx": 0.56, "cy": 0.45, "motion": "zoom_in"},
  {"text": "Tavuk çiftliklerinde sürüyü korumak için bekçi olarak kullanılıyor.", "image": "p7.jpg", "cx": 0.5, "cy": 0.4, "motion": "zoom_out"},
  {"text": "Yuvasını yere değil, alçak ağaç ve çalılara kuruyor.", "image": "p8.jpg", "cx": 0.5, "cy": 0.4, "motion": "zoom_in"},
  {"text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.", "image": "p1.jpg", "cx": 0.5, "cy": 0.35, "motion": "pan_left"}
 ],
