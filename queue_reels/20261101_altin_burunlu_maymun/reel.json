  "segments": [
    {
      "text": "Altın burunlu maymun, insan dışında en soğuğa dayanan primat.",
      "image": "p1.jpg",
      "cx": 0.25,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Çin'in dağlık ormanlarında, 1.500 ile 3.400 metre arasında yaşıyor.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Yaşadığı bölgeye sık sık kar yağıyor.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Ana besini, ağaçlarda biten likenler.",
      "image": "p4.jpg",
      "cx": 0.3,
      "cy": 0.3,
      "motion": "pan_left"
    },
    {
      "text": "Kümelenerek uyumalarının nedeni, ısıyı korumak olabilir.",
      "image": "p5.jpg",
      "cx": 0.65,
      "cy": 0.45,
      "motion": "pan_right"
    },
    {
      "text": "Gruplar beş on bireyden, yaklaşık altı yüz bireylik sürülere kadar değişiyor.",
      "image": "p7.jpg",
      "cx": 0.8,
      "cy": 0.65,
      "motion": "pan_right"
    },
    {
      "text": "Yavrulara anneler kadar diğer dişiler de bakıyor.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Yaşam alanı kaybı yüzünden nesli tehlike altında.",
      "image": "p8.jpg",
      "cx": 0.69,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p9.jpg",
      "cx": 0.5,
      "cy": 0.3,
      "motion": "pan_left"
    }
  ],
