 "segments": [
  {
   "text": "Bu süslü kuşun derisi zehirli olabilir.",
   "image": "p1.jpg",
   "cx": 0.4,
   "cy": 0.25,
   "motion": "zoom_in"
  },
  {
   "text": "Küçük cennet kuşu en fazla otuz iki santimetre uzunluğunda.",
   "image": "p2.jpg",
   "cx": 0.45,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Erkeğin boğazı zümrüt yeşili, böğründeki süs tüyleri dipte sarı, uçlara doğru beyaz.",
   "image": "p3.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "pan_right"
  },
  {
   "text": "Erkekler birden fazla dişiyle çiftleşiyor ve toplu gösteri alanlarında kur yapıyor.",
   "image": "p4.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "pan_left"
  },
  {
   "text": "Dişi, ağaçların yüksek dallarına yuva yapıp genellikle iki yumurta bırakıyor.",
   "image": "p5.jpg",
   "cx": 0.45,
   "cy": 0.35,
   "motion": "pan_right"
  },
  {
   "text": "Kuzey Yeni Gine ormanlarında, Misool ve Yapen adalarında yaşıyor.",
   "image": "p6.jpg",
   "cx": 0.45,
   "cy": 0.4,
   "motion": "zoom_out"
  },
  {
   "text": "Meyve ve böceklerle besleniyor; zehir muhtemelen böceklerden geliyor.",
   "image": "p7.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p1.jpg",
   "cx": 0.4,
   "cy": 0.25,
   "motion": "zoom_out"
  }
