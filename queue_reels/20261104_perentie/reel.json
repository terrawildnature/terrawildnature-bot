  "segments": [
    {
      "text": "Bu dev kertenkele, arka ayaklarının üstünde doğrulup etrafı gözetliyor.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Perentie, Avustralya'nın en büyük kertenkelesi.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Boyu iki buçuk metreye, ağırlığı yirmi kiloya kadar çıkabiliyor.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Dünyada Komodo ejderi ve iki varandan sonra dördüncü büyük kertenkele sayılıyor.",
      "image": "p4.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Avustralya'nın kurak çöllerinde, kayalık geçitlerde yaşıyor ve çok çekingen.",
      "image": "p5.jpg",
      "cx": 0.1,
      "cy": 0.7,
      "motion": "pan_left"
    },
    {
      "text": "Birkaç dakikada yuva kazıyor, uzun pençeleriyle ağaca tırmanıyor.",
      "image": "p6.jpg",
      "cx": 0.1,
      "cy": 0.7,
      "motion": "pan_right"
    },
    {
      "text": "Avları arasında genç kangurular da var.",
      "image": "p7.jpg",
      "cx": 0.1,
      "cy": 0.7,
      "motion": "pan_left"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p1.jpg",
      "cx": 0.1,
      "cy": 0.7,
