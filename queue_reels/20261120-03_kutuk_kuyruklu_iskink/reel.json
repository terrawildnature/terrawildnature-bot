 "segments": [
  {
   "text": "Bu kertenkele, aynı eşine yirmi yıl boyunca geri dönebiliyor.",
   "image": "p1.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "zoom_in"
  },
  {
   "text": "Avustralya'ya özgü bu iskink, mavi dilli kertenkeleler cinsinden.",
   "image": "p2.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Kısa, kalın kuyruğu başına o kadar benziyor ki ona iki başlı iskink deniyor.",
   "image": "p3.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Bu kuyruk yırtıcıları şaşırtabiliyor; ayrıca yağ deposu görevi görüyor.",
   "image": "p4.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Tehdit altında ağzını açıp mavi dilini gösteriyor ve tıslıyor.",
   "image": "p5.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "zoom_out"
  },
  {
   "text": "Salyangoz ve bitki yiyen bir hepçil.",
   "image": "p6.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Yumurtlamıyor, çoğunlukla iki ya da üç yavru doğuruyor.",
   "image": "p7.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Bazı bireylerin elli yıl yaşadığı biliniyor.",
   "image": "p8.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "zoom_in"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p9.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  }
 ],
