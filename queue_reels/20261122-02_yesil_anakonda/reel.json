 "segments": [
  {
   "text": "Dünyanın en ağır yılanı olan yeşil anakonda, 6 metreden uzun olabiliyor.",
   "image": "p1.jpg",
   "cx": 0.65,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "5 metrelik bir anakonda, 7 metrelik ağ desenli piton kadar hacimli.",
   "image": "p2.jpg",
   "cx": 0.2,
   "cy": 0.3,
   "motion": "pan_right"
  },
  {
   "text": "Gözleri başının üstünde olduğu için vücudunu göstermeden sudan dışarıyı izliyor.",
   "image": "p3.jpg",
   "cx": 0.7,
   "cy": 0.4,
   "motion": "pan_left"
  },
  {
   "text": "Çene kemikleri esnek bağlarla bağlı, bu yüzden kafasından büyük avı yutabiliyor.",
   "image": "p4.jpg",
   "cx": 0.4,
   "cy": 0.45,
   "motion": "pan_right"
  },
  {
   "text": "Yutarken soluk borusu ağzına uzanıp nefes almasını sağlıyor.",
   "image": "p5.jpg",
   "cx": 0.45,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Sindirim günler sürüyor ve bu sırada hareketsiz kalıyor.",
   "image": "p6.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Karip halkı ona Büyük Yılan anlamına gelen akayima diyor.",
   "image": "p7.jpg",
   "cx": 0.7,
   "cy": 0.4,
   "motion": "pan_left"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p8.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "zoom_out"
  }
 ],
