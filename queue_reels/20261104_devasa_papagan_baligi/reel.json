      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Yeşil tümsek başlı papağan balığı, papağan balıklarının en büyüğü.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Boyu bir metre otuzu, ağırlığı kırk altı kiloyu bulabiliyor.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Kızıldeniz'den Samoa'ya kadar Hint ve Pasifik okyanuslarının resiflerinde yaşıyor.",
      "image": "p4.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Yosunla ve canlı mercanla besleniyor.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Bir yetişkin yılda beş tondan fazla resif kayasını sindiriyor.",
      "image": "p6.jpg",
