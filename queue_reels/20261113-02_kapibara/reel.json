 "segments": [
  {
   "text": "Bu kemirgen suyun altında beş dakikaya kadar nefesini tutabiliyor.",
   "image": "p1.jpg",
   "cx": 0.5,
   "cy": 0.55,
   "motion": "zoom_in"
  },
  {
   "text": "Kapibara, dünyanın yaşayan en büyük kemirgeni.",
   "image": "p2.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Güney Amerika'da Şili hariç her ülkede yaşıyor.",
   "image": "p3.jpg",
   "cx": 0.4,
   "cy": 0.42,
   "motion": "zoom_out"
  },
  {
   "text": "Nehir, göl ve bataklık kenarlarında yarı sucul bir hayat sürüyor.",
   "image": "p4.jpg",
   "cx": 0.55,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Sıcak öğleden sonraları suda dinlenip serinliyor.",
   "image": "p5.jpg",
   "cx": 0.4,
   "cy": 0.38,
   "motion": "zoom_in"
  },
  {
   "text": "Genellikle on ile yirmi bireylik gruplar hâlinde yaşıyor, bazen sayı yüze ulaşıyor.",
   "image": "p6.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Yiyeceğini yanlara değil, ileri geri hareketle öğütüyor.",
   "image": "p7.jpg",
   "cx": 0.55,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Kendi dışkısını yiyerek bağırsaktaki faydalı bakterileri yeniliyor.",
   "image": "p8.jpg",
   "cx": 0.5,
   "cy": 0.35,
   "motion": "zoom_in"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p1.jpg",
