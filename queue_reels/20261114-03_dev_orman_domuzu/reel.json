 "segments": [
  {
   "text": "İki yüz yetmiş beş kiloya ulaşabilen dev orman domuzu, ortalamada yaşayan en büyük domuzgil.",
   "image": "p1.jpg",
   "cx": 0.58,
   "cy": 0.55,
   "motion": "pan_right"
  },
  {
   "text": "Omuz yüksekliği bir metreyi aşabiliyor.",
   "image": "p2.jpg",
   "cx": 0.35,
   "cy": 0.55,
   "motion": "zoom_in"
  },
  {
   "text": "Batı ve Orta Afrika'nın Gine ve Kongo ormanlarında yaşıyor.",
   "image": "p3.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "pan_left"
  },
  {
   "text": "Kenya Dağı'na ve Etiyopya yaylalarına kadar uzanıyor, üç bin sekiz yüz metreye çıkabiliyor.",
   "image": "p4.jpg",
   "cx": 0.5,
   "cy": 0.35,
   "motion": "pan_right"
  },
  {
   "text": "Kuruluğa ve uzun süre güneşe dayanamadığı için yoğun örtülü yerlerde yaşıyor.",
   "image": "p5.jpg",
   "cx": 0.39,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Erkekleri bazen uyarmadan saldırdığı için kızıl nehir domuzundan bile daha çok korkuluyor.",
   "image": "p6.jpg",
   "cx": 0.35,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Benekli sırtlanları leşten uzaklaştırdığı bile biliniyor.",
   "image": "p7.jpg",
   "cx": 0.4,
   "cy": 0.4,
   "motion": "pan_right"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p1.jpg",
   "cx": 0.58,
   "cy": 0.55,
   "motion": "zoom_out"
  }
 ],
