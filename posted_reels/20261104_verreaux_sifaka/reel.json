  "segments": [
    {
      "text": "Bu primat ağaçlar arasında on metreye varan sıçrayışlar yapabiliyor.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Verreaux sifakası, Madagaskar'a özgü bir lemur türü.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Boyu yaklaşık kırk beş santim, ağırlığı üç buçuk kilo.",
      "image": "p3.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Ağaçlarda dikey tutunup sıçrıyor, yere inince iki ayağı üzerinde dans eder gibi zıplıyor.",
      "image": "p4.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Gruplarında dişiler baskın olduğu için toplumları anaerkil.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Yaprak, meyve, kabuk ve çiçekle besleniyor.",
      "image": "p6.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Yavrularının yaklaşık yüzde otuzu fossaya yem oluyor.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Kritik derecede nesli tehlike altında.",
      "image": "p8.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_out"
    }
  ],
