 "segments": [
  {
   "text": "Bu gibonun boğazındaki kese, kafası kadar büyüyebiliyor.",
   "image": "p1.jpg",
   "cx": 0.55,
   "cy": 0.5,
   "motion": "pan_right"
  },
  {
   "text": "Siamang, gibonların en büyüğü ve ağırlığı on dört kiloya ulaşabiliyor.",
   "image": "p2.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Şişirdiği kese, çağrılarını ormanda yankılanan bir sese çeviriyor.",
   "image": "p8.jpg",
   "cx": 0.3,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Sabahları Sumatra ve Malezya ormanlarının sessizliğini şarkısıyla bozuyor.",
   "image": "p5.jpg",
   "cx": 0.55,
   "cy": 0.55,
   "motion": "pan_right"
  },
  {
   "text": "Ayaklarında iki parmak zarla birleşik; adı da buradan geliyor.",
   "image": "p3.jpg",
   "cx": 0.45,
   "cy": 0.6,
   "motion": "zoom_out"
  },
  {
   "text": "Kolları bacaklarından uzun, dallar arasında ustaca sallanıyor.",
   "image": "p6.jpg",
   "cx": 0.42,
   "cy": 0.55,
   "motion": "pan_left"
  },
  {
   "text": "En sevdiği yiyecek incir, ama en az yüz altmış bitki türü yiyor.",
   "image": "p4.jpg",
   "cx": 0.6,
   "cy": 0.45,
   "motion": "pan_right"
  },
  {
   "text": "Babalar yavruyu taşımada büyük rol alıyor.",
   "image": "p7.jpg",
   "cx": 0.62,
   "cy": 0.55,
   "motion": "pan_left"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p1.jpg",
   "cx": 0.55,
   "cy": 0.5,
   "motion": "pan_left"
  }
