  "segments": [
    {
      "text": "Tek bir balina köpekbalığının karnında yaklaşık 300 yavru bulundu.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Bu dev, bilinen en büyük balık türü.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Plankton, krill ve sardalya gibi küçük balıklarla besleniyor.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Süzerek beslenen yalnızca üç köpekbalığı türünden biri.",
      "image": "p6.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Ağzında 300'den fazla sıra minik diş var.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Üzerindeki benek deseni her bireyde farklı.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Kaydedilen en derin dalışı 1.928 metre.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_out"
    },
    {
      "text": "Ömrünün 80 ile 130 yıl arasında olduğu tahmin ediliyor.",
      "image": "p6.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
