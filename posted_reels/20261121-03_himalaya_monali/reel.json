 "segments": [
  {
   "text": "Bu kuş, dört bin beş yüz metreye kadar çıkan yamaçlarda yaşıyor.",
   "image": "p1.jpg",
   "cx": 0.65,
   "cy": 0.45,
   "motion": "pan_right"
  },
  {
   "text": "Adı Himalaya monali, Nepal'de ise danfe olarak biliniyor.",
   "image": "p2.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "pan_left"
  },
  {
   "text": "Nepal'in ulusal kuşu, Hindistan'ın Uttarakhand eyaletinin de eyalet kuşu.",
   "image": "p3.jpg",
   "cx": 0.47,
   "cy": 0.45,
   "motion": "pan_right"
  },
  {
   "text": "Karı kazarak yumru, filiz ve böcek buluyor.",
   "image": "p4.jpg",
   "cx": 0.22,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Erkeğin tüyleri çok renkli; tepesi metalik yeşil, sırtı bakır rengi.",
   "image": "p5.jpg",
   "cx": 0.45,
   "cy": 0.4,
   "motion": "pan_right"
  },
  {
   "text": "Uçarken belindeki beyaz leke belirginleşiyor.",
   "image": "p6.jpg",
   "cx": 0.12,
   "cy": 0.65,
   "motion": "pan_left"
  },
  {
   "text": "Dişi ise çok daha sönük renkli ve boğazında beyaz bir leke var.",
   "image": "p7.jpg",
   "cx": 0.5,
   "cy": 0.75,
   "motion": "pan_right"
  },
  {
   "text": "Tepesi değerli olduğu için kaçak avlanması en büyük tehdit.",
   "image": "p8.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "zoom_in"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
   "image": "p9.jpg",
   "cx": 0.5,
   "cy": 0.45,
   "motion": "zoom_in"
  }
 ],
