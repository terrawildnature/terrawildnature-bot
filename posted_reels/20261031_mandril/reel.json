  "segments": [
    {
      "text": "Mandril, dünyadaki en büyük maymun türü.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Yüzündeki kırmızı ve mavi renkler onu en renkli memelilerden biri yapıyor.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Kırmızı renk, deriye yakın damarlardan geliyor.",
      "image": "p6.jpg",
      "cx": 0.62,
      "cy": 0.5,
      "motion": "zoom_in"
    },
    {
      "text": "Mavi renk ise kolajen liflerinin dizilişinden oluşuyor.",
      "image": "p4.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Erkekler 19 ile 30 kilo, dişiler 10 ile 15 kilo ağırlığında.",
      "image": "p5.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Batı-orta Afrika'nın yağmur ormanlarında yaşıyorlar.",
      "image": "p6.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_right"
    },
    {
      "text": "Gabon'da sürüler yüzlerce, hatta 800'den fazla bireye ulaşabiliyor.",
      "image": "p7.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_out"
    },
    {
      "text": "Meyve ve tohum yiyor, ama böcek ve küçük geyik yavrularını da yiyor.",
      "image": "p1.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "pan_left"
    },
    {
      "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
      "image": "p2.jpg",
      "cx": 0.5,
      "cy": 0.5,
      "motion": "zoom_in"
    }
  ],
