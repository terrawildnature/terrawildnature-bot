 "segments": [
  {
   "text": "Bu maymunun sesi iki kilometre öteden duyulabiliyor.",
   "image": "p1.jpg",
   "cx": 0.5,
   "cy": 0.3,
   "motion": "pan_right"
  },
  {
   "text": "Karaya uluyan maymun, Yeni Dünya'nın en büyük maymunlarından biri.",
   "image": "p2.jpg",
   "cx": 0.5,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Boğazındaki büyük hyoid kemiğinin ulumaya yardım ettiği düşünülüyor.",
   "image": "p3.jpg",
   "cx": 0.5,
   "cy": 0.35,
   "motion": "zoom_out"
  },
  {
   "text": "Genellikle şafak vakti ulur ve bölgesini ilan eder.",
   "image": "p4.jpg",
   "cx": 0.55,
   "cy": 0.3,
   "motion": "pan_left"
  },
  {
   "text": "Erkekler yaşlandıkça altın rengi tüylerini kaybedip simsiyah oluyor.",
   "image": "p5.jpg",
   "cx": 0.55,
   "cy": 0.35,
   "motion": "pan_right"
  },
  {
   "text": "Dişiler ve yavrular ise altın sarısı kalıyor.",
   "image": "p6.jpg",
   "cx": 0.5,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Çıplak tabanlı kuyruğu, beşinci bir kol gibi dalları kavrıyor.",
   "image": "p7.jpg",
   "cx": 0.78,
   "cy": 0.4,
   "motion": "zoom_in"
  },
  {
   "text": "Günün yüzde altmış, yetmişini dinlenerek ya da uyuyarak geçiriyor.",
   "image": "p8.jpg",
   "cx": 0.4,
   "cy": 0.5,
   "motion": "pan_left"
  },
  {
   "text": "Canlılar hakkında daha fazla bilgi alabilmek için bizi takip etmeyi unutmayın.",
